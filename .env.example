# Empty in dev so axios uses the Vite proxy (same-origin, first-party cookies).
VITE_API_URL=
VITE_SOCKET_URL=

# NOTE: every VITE_-prefixed variable is PUBLIC — it is inlined into the bundle.
# There is no way to hide a Maps key in a browser app. The real control is an
# HTTP-referrer restriction plus an API restriction (Maps JavaScript + Distance
# Matrix only) configured in the Google Cloud console.
VITE_GMAPS_KEY=

# --- Production (Render Web Service) ---------------------------------------
# In production these point DIRECTLY at the backend, so the browser bypasses
# server.js's /api proxy. Cloudflare fronts the Render service and was
# rate-limiting real browsers by IP with 429s our Express app cannot produce;
# going direct removes that layer from the API path.
#
#   VITE_API_URL=https://darkslategrey-penguin-138082.hostingersite.com
#   VITE_SOCKET_URL=https://darkslategrey-penguin-138082.hostingersite.com
#
# This makes API calls cross-origin, which needs BOTH of these on the backend
# (already deployed): a refresh cookie set SameSite=None; Secure, and CORS
# echoing the app origin with Access-Control-Allow-Credentials.
#
# server.js still proxies /api for anyone who prefers the same-origin setup —
# leave both VITE_ vars empty and set the server-side target instead:
#   API_PROXY_TARGET=https://darkslategrey-penguin-138082.hostingersite.com
