# Empty in dev so axios uses the Vite proxy (same-origin, first-party cookies).
VITE_API_URL=
VITE_SOCKET_URL=

# NOTE: every VITE_-prefixed variable is PUBLIC — it is inlined into the bundle.
# There is no way to hide a Maps key in a browser app. The real control is an
# HTTP-referrer restriction plus an API restriction (Maps JavaScript + Distance
# Matrix only) configured in the Google Cloud console.
VITE_GMAPS_KEY=
